import torch

discount_factor_long_term=0.9
discount_factor_short_term=0.1

rewards=torch.tensor([1,3,2,3,4,1,2,1,2,7,3,8,1,1,0,8,9])
def calculate_discount(factor, rewards):
  factors=torch.arange(len(rewards))
  factors=factor**factors
  rewards_multiplied=rewards*factors
  return torch.sum(rewards_multiplied)
print(calculate_discount(discount_factor_long_term, rewards))
print(calculate_discount(discount_factor_short_term, rewards))
